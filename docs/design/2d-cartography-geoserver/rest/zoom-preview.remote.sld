      <sld:FeatureTypeStyle>
        <sld:Name>zoom-road</sld:Name>
        <sld:Rule>
          <sld:Name>zoom-road</sld:Name>
          <sld:MinScaleDenominator>17061.8366708</sld:MinScaleDenominator>
