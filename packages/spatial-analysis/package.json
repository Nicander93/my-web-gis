{
  "name": "@desktop-webgis/spatial-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/index.js",
    "test": "vitest run",
    "benchmark": "node examples/benchmark.mjs",
    "benchmark:complex": "node examples/complex-benchmark.mjs",
    "test:consumer": "node examples/consumer.mjs && tsc --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext examples/consumer.ts"
  },
  "dependencies": {
    "@turf/area": "7.3.4",
    "@turf/length": "7.3.4",
    "@types/geojson": "7946.0.16",
    "jsep": "1.4.0",
    "jsts": "2.7.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
