{
  "name": "@desktop-webgis/cesium-scene-runtime",
  "version": "0.1.0",
  "description": "Independent cesium-scene-runtime API for Cesium city scenes",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
