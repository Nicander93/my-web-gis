{
  "name": "@desktop-webgis/scene-core",
  "version": "0.1.0",
  "description": "Framework-independent scene creation and immutable update utilities.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@desktop-webgis/scene-schema": "workspace:*",
    "@desktop-webgis/gis-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
