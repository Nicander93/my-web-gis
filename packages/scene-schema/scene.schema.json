    "cityWater": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "popup": {
          "$ref": "#/$defs/cityPopup"
        },
        "locked": {
          "type": "boolean"
        },
        "type": {
          "const": "water"
        },
        "boundary": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/cityPosition"
          }
        },
        "height": {
          "type": "number"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        },
        "amplitude": {
          "type": "number",
          "minimum": 0
        },
        "frequency": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
