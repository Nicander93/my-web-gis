            "glb",
            "geojson"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    "cityTileset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "popup": {
          "$ref": "#/$defs/cityPopup"
        },
        "locked": {
          "type": "boolean"
        },
        "type": {
          "const": "3dtiles"
        },
        "asset": {
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/cityTransform"
        },
        "maximumScreenSpaceError": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cacheBytes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "visible",
        "type",
        "asset",
        "transform"
      ]
    },
    "cityModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "popup": {
          "$ref": "#/$defs/cityPopup"
        },
        "locked": {
          "type": "boolean"
        },
        "type": {
          "const": "model"
        },
        "asset": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/cityPosition"
        },
        "transform": {
          "$ref": "#/$defs/cityTransform"
        }
      },
      "required": [
        "id",
        "name",
        "visible",
        "type",
        "asset",
        "position",
