      ]
    },
    "cityGeoJson": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "popup": {
          "$ref": "#/$defs/cityPopup"
        },
        "locked": {
          "type": "boolean"
        },
        "type": {
          "const": "geojson"
        },
        "asset": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
