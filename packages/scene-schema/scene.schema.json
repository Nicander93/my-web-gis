{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-webgis.dev/schemas/map-scene.json",
  "title": "Desktop WebGIS SceneManifest (v1 readable, v2 current)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "view",
    "sources",
    "layers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "description": {
      "type": "string"
    },
    "view": {
      "$ref": "#/$defs/view"
    },
    "credentials": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/credentialReference"
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/tileLayer"
          },
          {
            "$ref": "#/$defs/vectorLayer"
          }
        ]
      }
    },
    "widgets": {
      "$ref": "#/$defs/widgets"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "metadata": {
      "type": "object"
    },
    "city": {
      "$ref": "#/$defs/cityScene"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "finiteNumber": {
      "type": "number"
    },
    "numberPair": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/finiteNumber"
        },
        {
          "$ref": "#/$defs/finiteNumber"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "extent": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/finiteNumber"
        },
        {
          "$ref": "#/$defs/finiteNumber"
        },
        {
          "$ref": "#/$defs/finiteNumber"
        },
        {
          "$ref": "#/$defs/finiteNumber"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "center",
        "zoom"
      ],
      "properties": {
        "projection": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "center": {
          "$ref": "#/$defs/numberPair"
        },
        "zoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "rotation": {
          "$ref": "#/$defs/finiteNumber"
        },
        "minZoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "maxZoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "extent": {
          "$ref": "#/$defs/extent"
        }
      }
    },
    "geoJsonFeatureCollection": {
      "type": "object",
      "required": [
        "type",
        "features"
      ],
      "properties": {
        "type": {
          "const": "FeatureCollection"
        },
        "features": {
          "type": "array"
        }
      }
    },
    "credentialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key"
      ],
      "properties": {
        "type": {
          "const": "runtime-reference"
        },
        "key": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/geoJsonSource"
        },
        {
          "$ref": "#/$defs/xyzSource"
        },
        {
          "$ref": "#/$defs/tiandituSource"
        },
        {
          "$ref": "#/$defs/googleMapTilesSource"
        }
      ]
    },
    "geoJsonSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "geojson"
        },
        "data": {
          "$ref": "#/$defs/geoJsonFeatureCollection"
        },
        "url": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dataProjection": {
          "type": "string"
        },
        "idField": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "data"
          ],
          "not": {
            "required": [
              "url"
            ]
          }
        },
        {
          "required": [
            "url"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    },
    "xyzSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "const": "xyz"
        },
        "url": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "crossOrigin": {
          "enum": [
            "anonymous",
            "use-credentials"
          ]
        },
        "maxZoom": {
          "type": "number",
          "minimum": 0
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "tiandituSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "mapType",
        "credential"
      ],
      "properties": {
        "type": {
          "const": "provider"
        },
        "provider": {
          "const": "tianditu"
        },
        "mapType": {
          "enum": [
            "vector",
            "imagery",
            "terrain"
          ]
        },
        "projection": {
          "enum": [
            "EPSG:3857",
            "EPSG:4326"
          ]
        },
        "withLabels": {
          "type": "boolean"
        },
        "credential": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "googleMapTilesSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "mapType",
        "language",
        "region",
        "credential"
      ],
      "properties": {
        "type": {
          "const": "provider"
        },
        "provider": {
          "const": "google-map-tiles"
        },
        "mapType": {
          "enum": [
            "roadmap",
            "satellite",
            "terrain"
          ]
        },
        "language": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "region": {
          "type": "string",
          "pattern": "^[A-Za-z]{2}$"
        },
        "credential": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "tileLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "tile"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minZoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "maxZoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "role": {
          "enum": [
            "basemap",
            "overlay"
          ]
        }
      }
    },
    "vectorLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "source",
        "style"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "const": "vector"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "style": {
          "oneOf": [
            {
              "$ref": "#/$defs/legacyStyle"
            },
            {
              "$ref": "#/$defs/layerStyle"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "interaction": {
          "$ref": "#/$defs/interaction"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minZoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "maxZoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "role": {
          "enum": [
            "basemap",
            "overlay"
          ]
        }
      }
    },
    "style": {
      "oneOf": [
        {
          "$ref": "#/$defs/pointStyle"
        },
        {
          "$ref": "#/$defs/lineStyle"
        },
        {
          "$ref": "#/$defs/polygonStyle"
        }
      ]
    },
    "pointStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "radius",
        "fill"
      ],
      "properties": {
        "type": {
          "const": "point"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fill": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stroke": {
          "type": "string"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "lineStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "color",
        "width"
      ],
      "properties": {
        "type": {
          "const": "line"
        },
        "color": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lineDash": {
          "$ref": "#/$defs/lineDash"
        }
      }
    },
    "polygonStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fill",
        "stroke",
        "strokeWidth"
      ],
      "properties": {
        "type": {
          "const": "polygon"
        },
        "fill": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stroke": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "lineDash": {
          "$ref": "#/$defs/lineDash"
        }
      }
    },
    "lineDash": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "color": {
          "type": "string"
        },
        "font": {
          "type": "string"
        },
        "haloColor": {
          "type": "string"
        },
        "haloWidth": {
          "type": "number",
          "minimum": 0
        },
        "offset": {
          "$ref": "#/$defs/numberPair"
        },
        "minZoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "maxZoom": {
          "$ref": "#/$defs/finiteNumber"
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selectable": {
          "type": "boolean"
        },
        "popup": {
          "$ref": "#/$defs/popup"
        }
      }
    },
    "popup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "titleField": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/popupField"
          }
        }
      }
    },
    "popupField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "type": "string"
        },
        "format": {
          "enum": [
            "text",
            "number",
            "date",
            "url"
          ]
        }
      }
    },
    "widgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layerSwitcher": {
          "type": "boolean"
        },
        "legend": {
          "type": "boolean"
        },
        "scaleLine": {
          "type": "boolean"
        },
        "fullscreen": {
          "type": "boolean"
        },
        "zoom": {
          "type": "boolean"
        },
        "mousePosition": {
          "type": "boolean"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string"
        },
        "colorScheme": {
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "accent": {
          "type": "string"
        },
        "surface": {
          "enum": [
            "solid",
            "glass"
          ]
        },
        "fontFamily": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chapter"
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "view"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "visibleLayers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "highlightedFeatureIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "sceneColor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "a": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "pointSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "radius"
      ],
      "properties": {
        "type": {
          "const": "circle"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fill": {
          "$ref": "#/$defs/sceneColor"
        },
        "stroke": {
          "$ref": "#/$defs/sceneColor"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "lineSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "color",
        "width"
      ],
      "properties": {
        "type": {
          "const": "solid"
        },
        "color": {
          "$ref": "#/$defs/sceneColor"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lineDash": {
          "$ref": "#/$defs/lineDash"
        }
      }
    },
    "polygonSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "solid"
        },
        "fill": {
          "$ref": "#/$defs/sceneColor"
        },
        "stroke": {
          "$ref": "#/$defs/sceneColor"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "lineDash": {
          "$ref": "#/$defs/lineDash"
        }
      }
    },
    "mixedSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "mixed"
        },
        "point": {
          "$ref": "#/$defs/pointSymbol"
        },
        "line": {
          "$ref": "#/$defs/lineSymbol"
        },
        "polygon": {
          "$ref": "#/$defs/polygonSymbol"
        }
      }
    },
    "sceneSymbol": {
      "oneOf": [
        {
          "$ref": "#/$defs/pointSymbol"
        },
        {
          "$ref": "#/$defs/lineSymbol"
        },
        {
          "$ref": "#/$defs/polygonSymbol"
        },
        {
          "$ref": "#/$defs/mixedSymbol"
        }
      ]
    },
    "labelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "$ref": "#/$defs/sceneColor"
        },
        "strokeColor": {
          "$ref": "#/$defs/sceneColor"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "offsetX": {
          "$ref": "#/$defs/finiteNumber"
        },
        "offsetY": {
          "$ref": "#/$defs/finiteNumber"
        },
        "minZoom": {
          "$ref": "#/$defs/finiteNumber"
        },
        "maxZoom": {
          "$ref": "#/$defs/finiteNumber"
        }
      }
    },
    "singleLayerStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "symbol"
      ],
      "properties": {
        "mode": {
          "const": "single"
        },
        "symbol": {
          "$ref": "#/$defs/sceneSymbol"
        },
        "label": {
          "$ref": "#/$defs/labelConfig"
        }
      }
    },
    "categoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "symbol"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "symbol": {
          "$ref": "#/$defs/sceneSymbol"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "categorizedLayerStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "field",
        "categories",
        "fallback"
      ],
      "properties": {
        "mode": {
          "const": "categorized"
        },
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/categoryItem"
          }
        },
        "fallback": {
          "$ref": "#/$defs/sceneSymbol"
        },
        "label": {
          "$ref": "#/$defs/labelConfig"
        }
      }
    },
    "graduatedBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "symbol"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/finiteNumber"
        },
        "symbol": {
          "$ref": "#/$defs/sceneSymbol"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "graduatedLayerStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "field",
        "method",
        "breaks",
        "fallback"
      ],
      "properties": {
        "mode": {
          "const": "graduated"
        },
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "method": {
          "enum": [
            "equal-interval",
            "quantile",
            "manual"
          ]
        },
        "breaks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graduatedBreak"
          }
        },
        "fallback": {
          "$ref": "#/$defs/sceneSymbol"
        },
        "label": {
          "$ref": "#/$defs/labelConfig"
        }
      }
    },
    "legacyStyle": {
      "oneOf": [
        {
          "$ref": "#/$defs/pointStyle"
        },
        {
          "$ref": "#/$defs/lineStyle"
        },
        {
          "$ref": "#/$defs/polygonStyle"
        }
      ]
    },
    "layerStyle": {
      "oneOf": [
        {
          "$ref": "#/$defs/singleLayerStyle"
        },
        {
          "$ref": "#/$defs/categorizedLayerStyle"
        },
        {
          "$ref": "#/$defs/graduatedLayerStyle"
        }
      ]
    },
    "cityPosition": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "cityTriple": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "cityTransform": {
      "type": "object",
      "properties": {
        "translation": {
          "$ref": "#/$defs/cityTriple"
        },
        "rotation": {
          "$ref": "#/$defs/cityTriple"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "translation",
        "rotation",
        "scale"
      ]
    },
    "cityPopup": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "titleField": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "field"
            ]
          }
        }
      },
      "required": [
        "fields"
      ]
    },
    "cityCamera": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/cityPosition"
        },
        "heading": {
          "type": "number"
        },
        "pitch": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "roll": {
          "type": "number"
        }
      },
      "required": [
        "position",
        "heading",
        "pitch",
        "roll"
      ]
