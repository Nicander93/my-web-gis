      ]
    },
    "cityScene": {
      "type": "object",
      "properties": {
        "version": {
          "enum": [
            1,
            2
          ]
        },
        "camera": {
          "$ref": "#/$defs/cityCamera"
        },
        "basemap": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "attribution": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        "terrain": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cityAsset"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/cityTileset"
              },
              {
                "$ref": "#/$defs/cityModel"
              },
              {
                "$ref": "#/$defs/cityGeoJson"
              },
              {
                "$ref": "#/$defs/cityWater"
              },
              {
                "$ref": "#/$defs/cityGraphic"
              }
            ]
          }
        },
        "effects": {
          "type": "object",
          "properties": {
            "fog": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bloom": {
              "type": "boolean"
            }
          },
          "required": [
            "fog",
            "bloom"
          ]
        },
        "lighting": {
          "type": "object",
          "properties": {
            "sunlight": {
              "type": "boolean"
            },
            "shadows": {
              "type": "boolean"
            },
            "time": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "sunlight",
            "shadows",
            "time"
          ]
        }
      },
      "required": [
        "version",
        "camera",
        "assets",
        "nodes",
        "effects"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "version": {
                "const": 1
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "lighting"
              ]
            },
            "properties": {
              "nodes": {
                "items": {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "graphic"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "cityGraphic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "popup": {
          "$ref": "#/$defs/cityPopup"
        },
        "locked": {
          "type": "boolean"
        },
        "type": {
          "const": "graphic"
        },
        "geometry": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "point",
                "polyline",
                "polygon"
              ]
            },
            "positions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cityPosition"
              }
            },
            "heightMode": {
              "enum": [
                "ground",
                "absolute"
              ]
            }
          },
          "required": [
            "type",
            "positions",
            "heightMode"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "point"
                  }
                }
              },
              "then": {
                "properties": {
                  "positions": {
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "polyline"
                  }
                }
              },
              "then": {
                "properties": {
                  "positions": {
                    "minItems": 2
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "polygon"
                  }
                }
              },
              "then": {
                "properties": {
                  "positions": {
                    "minItems": 3
                  }
                }
              }
            }
          ]
        },
        "style": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 64
            },
            "pointSize": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 128
            },
            "label": {
              "type": "string"
            },
            "labelField": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "color",
            "width",
            "pointSize"
          ]
        },
        "properties": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "visible",
        "type",
        "geometry",
        "style",
        "properties"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "city"
        ]
      },
      "then": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      }
    }
  ]
}
