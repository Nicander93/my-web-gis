{
  "name": "@desktop-webgis/ol-style",
  "version": "0.1.0",
  "description": "OpenLayers style utilities with JSON-serializable symbology and classification algorithms (equal interval, quantile).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./classification": {
      "types": "./dist/classification/index.d.ts",
      "import": "./dist/classification/index.js"
    },
    "./cartography": {
      "types": "./dist/cartography.d.ts",
      "import": "./dist/cartography.js"
    },
    "./cartography-model": {
      "types": "./dist/cartography-model.d.ts",
      "import": "./dist/cartography-model.js"
    },
    "./style-assets": {
      "types": "./dist/style-assets.d.ts",
      "import": "./dist/style-assets.js"
    },
    "./symbol-library": {
      "types": "./dist/symbol-library.d.ts",
      "import": "./dist/symbol-library.js"
    },
    "./cartography-operations": {
      "types": "./dist/cartography-operations.d.ts",
      "import": "./dist/cartography-operations.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pack:check": "pnpm build && pnpm pack --pack-destination .",
    "verify:consumer": "node ./scripts/verify-consumer.mjs"
  },
  "peerDependencies": {
    "ol": "^10.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ol": "^10.10.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "openlayers",
    "style",
    "symbology",
    "classification",
    "legend",
    "gis"
  ],
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.4.1",
    "@xmldom/xmldom": "0.9.12",
    "ol-mapbox-style": "13.8.0"
  }
}
