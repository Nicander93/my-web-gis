{
  "name": "@desktop-webgis/ol-style",
  "version": "0.1.0",
  "description": "OpenLayers style utilities with classification algorithms (equal interval, quantile).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./classification": {
      "types": "./dist/classification/index.d.ts",
      "import": "./dist/classification/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "ol": "^10.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ol": "^10.10.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
