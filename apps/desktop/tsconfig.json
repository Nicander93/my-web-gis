{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@desktop-webgis/project": ["../../packages/internal/project/src/index.ts"],
      "@desktop-webgis/ol-runtime": ["../../packages/internal/ol-runtime/src/index.ts"],
      "@desktop-webgis/ogc-io": ["../../packages/public/ogc-io/src/index.ts"],
      "@desktop-webgis/ogc-io/*": ["../../packages/public/ogc-io/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
