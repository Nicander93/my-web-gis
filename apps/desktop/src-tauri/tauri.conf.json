{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop WebGIS",
  "version": "0.1.0",
  "identifier": "com.desktop-webgis.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/scene-archives/**"]
      }
    },
    "windows": [
      {
        "title": "Desktop WebGIS",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
